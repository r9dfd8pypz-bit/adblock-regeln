#!name=YouTube werbefrei
#!desc=Entfernt Werbung in der YouTube- und YouTube-Music-App. Basiert auf Maasea/sgmodule (Apache-2.0), aber ohne Umleitung über fremde Server. (Modul v2: Video-Start lokal gefiltert)
#!arguments=UploadAusblenden:true,AusschnittAusblenden:true,ShortsAusblenden:false,Debug:false
#!arguments-desc=UploadAusblenden: Upload-Knopf ausblenden (true/false)\nAusschnittAusblenden: Ausschnitt-Knopf ausblenden (true/false)\nShortsAusblenden: Shorts-Knopf ausblenden (true/false)\nDebug: mehr Protokoll in Surge (true/false)

# Was dieses Modul macht:
# 1. QUIC sperren: YouTube nutzt sonst HTTP/3 über UDP, das Surge nicht entschlüsseln kann.
#    Die App weicht dann automatisch auf normales HTTPS aus.
# 2. Video-Start ("initplayback"): Die Anfrage geht unverändert an YouTube, und youtube.ump.js entfernt
#    die Werbung aus der Antwort, lokal auf dem iPhone. Nur wenn der nötige Schlüssel fehlt, antwortet
#    youtube.init.js leer, und die App nimmt den normalen Player-Weg (den youtube.response.js filtert).
#    Bis Modul v1 wurde initplayback IMMER leer beantwortet. Neuere YouTube-Apps (21.46) zeigen dann
#    beim nächsten Video „Ein Fehler ist aufgetreten“ (vgl. Maasea-Issue #111).
#    Das Original-Modul leitet diese Anfrage heute an einen Server des Skript-Autors um. Das machen wir NICHT.
# 3. Antworten von YouTube lokal auf dem iPhone umschreiben: Werbe-Einträge werden gelöscht,
#    bevor die App sie anzeigt. config/log_event liefern dabei den Schlüssel für Punkt 2.
#
# Entschlüsselt werden NUR die zwei YouTube-Adressen unten bei [MITM].

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/r9dfd8pypz-bit/adblock-regeln/main/scripts/youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":{{{UploadAusblenden}}},"blockImmersive":{{{AusschnittAusblenden}}},"blockShorts":{{{ShortsAusblenden}}},"debug":{{{Debug}}}}"
youtube.init.anfrage = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/r9dfd8pypz-bit/adblock-regeln/main/scripts/youtube/youtube.init.js
youtube.init.antwort = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/r9dfd8pypz-bit/adblock-regeln/main/scripts/youtube/youtube.ump.js,argument="{"captionLang":"off","lyricLang":"off"}"
youtube.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/r9dfd8pypz-bit/adblock-regeln/main/scripts/youtube/youtube.init.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
