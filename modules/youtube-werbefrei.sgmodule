#!name=YouTube werbefrei
#!desc=Entfernt Werbung in der YouTube- und YouTube-Music-App. Basiert auf Maasea/sgmodule (Apache-2.0), aber ohne Umleitung über fremde Server.
#!arguments=UploadAusblenden:true,AusschnittAusblenden:true,ShortsAusblenden:false,Debug:false
#!arguments-desc=UploadAusblenden: Upload-Knopf ausblenden (true/false)\nAusschnittAusblenden: Ausschnitt-Knopf ausblenden (true/false)\nShortsAusblenden: Shorts-Knopf ausblenden (true/false)\nDebug: mehr Protokoll in Surge (true/false)

# Was dieses Modul macht:
# 1. QUIC sperren: YouTube nutzt sonst HTTP/3 über UDP, das Surge nicht entschlüsseln kann.
#    Die App weicht dann automatisch auf normales HTTPS aus.
# 2. Video-Startanfrage ("initplayback") lokal leer beantworten. Die App fällt dann auf die
#    normale Player-Anfrage zurück, aus der das Skript die Werbung entfernt.
#    Das Original-Modul leitet diese Anfrage an einen Server des Skript-Autors um. Das machen wir NICHT.
# 3. Antworten von YouTube lokal auf dem iPhone umschreiben: Werbe-Einträge werden gelöscht,
#    bevor die App sie anzeigt.
#
# Entschlüsselt werden NUR die zwei YouTube-Adressen unten bei [MITM].

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^&]*&)*ack(?:=[^&]*)?(?:&|$) data-type=text data=""

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/r9dfd8pypz-bit/adblock-regeln/main/scripts/youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":{{{UploadAusblenden}}},"blockImmersive":{{{AusschnittAusblenden}}},"blockShorts":{{{ShortsAusblenden}}},"debug":{{{Debug}}}}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
